# Copiá este archivo como .env y cambiá lo que necesites.

# Contraseña del modo admin (¡cambiala!)
ADMIN_PASSWORD=admin

# on = el servidor corre el detector en segundo plano; off = lo corrés aparte
DETECTOR=on
# Cada cuántos segundos el detector revisa las carpetas camaras/*/fotos
INTERVALO_POLL=5
# Confianza mínima de YOLO para contar una detección
CONF_MIN=0.35
# Cuántas fotos ya procesadas se guardan por cámara (las demás se borran).
# 1 = solo la última (la usa el admin para recalibrar). 0 = ninguna.
MAX_PROCESADAS=1
# Pasado este tiempo sin fotos nuevas, la cuadra se ve como "SIN DATOS"
MINUTOS_SIN_DATOS=10

# on = el servidor va a buscar las fotos a las cámaras configuradas como
# "video" (RTSP/stream) o "foto" (URL de snapshot). off = no.
CAPTOR=on
# Si ya hay esta cantidad de fotos esperando al detector, no se toma otra
MAX_PENDIENTES=3
