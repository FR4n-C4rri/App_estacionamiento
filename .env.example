# Copiá este archivo como .env y cambiá lo que necesites.

# Contraseña del modo admin (¡cambiala!)
ADMIN_PASSWORD=admin

# on = el servidor corre el detector en segundo plano; off = lo corrés aparte
DETECTOR=on
# Cada cuántos segundos el detector revisa las carpetas camaras/*/fotos
INTERVALO_POLL=5
# Confianza mínima de YOLO para contar una detección
CONF_MIN=0.35
# Cuántas fotos ya procesadas se guardan por cámara (las demás se borran).
# 1 = solo la última (la usa el admin para recalibrar). 0 = ninguna.
MAX_PROCESADAS=1
# Pasado este tiempo sin fotos nuevas, la cuadra se ve como "SIN DATOS"
MINUTOS_SIN_DATOS=10


# --- Cómo se decide si un lugar está ocupado ---
# Cuánto de la parte baja de la caja del auto tiene que tapar al lugar (0 a 1).
# Bajalo si marcaste lugares muy chicos y el auto figura afuera; subilo si un
# auto estacionado también te marca el lugar de al lado.
MIN_SOLAPE=0.25
# Qué parte de la caja (desde abajo) se toma como lo que apoya en el suelo
HUELLA_FRAC=0.5
# Segundos que un lugar puede figurar vacío (el modelo no ve el auto en una o
# dos fotos) sin que se reinicie la cuenta de los 45 s. 0 = un hueco reinicia.
GRACIA_S=25
# Tamaño de entrada de YOLO. 0 = el del modelo (640). 960 o 1280 ayudan con
# autos lejanos en fotos grandes, a costa de bastante más CPU.
IMGSZ=0

# --- Que no crezca para siempre ---
# Fotos esperando por cámara; al pasarse se borran las más viejas (0 = sin tope)
MAX_FOTOS_EN_COLA=30
# Días que se guarda el historial de ocupación (0 = guardar todo)
HISTORIAL_DIAS=30
